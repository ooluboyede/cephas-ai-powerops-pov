{
  "schema_version": "cephas.powerops.lock-order.v1",
  "supersedes": "D-02.2 scope-mutex-first order where it conflicts with D-07 identity-first bootstrap",
  "transaction_rules": {
    "isolation": "READ COMMITTED",
    "acquire_all_rows_in_class_before_next_class": true,
    "sort": "UUID byte order; composite scope tenant UUID then business-unit UUID",
    "retry": "abort whole transaction; bounded retry from rank 0 only",
    "advisory_locks": "prohibited for authority serialization",
    "triggers_and_rls": "must not acquire out-of-order locks",
    "implicit_fk_locks": "pre-lock referenced rows at their declared rank"
  },
  "ranks": [
    {
      "rank": 0,
      "lock_class": "login_binding"
    },
    {
      "rank": 1,
      "lock_class": "identity_mapping"
    },
    {
