  "prohibited": [
    "mapping/login/session lock after scope mutex",
    "scope interleaving across lock classes",
    "trigger-initiated lock acquisition outside plan",
    "RLS side-effecting lock acquisition",
    "transaction pooling on governed sessions",
    "authority DML outside reviewed functions"
  ]
}
